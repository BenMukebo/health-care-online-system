<header class="flex justify-between items-center w-full px-16 pt-6 mb-2">
  <%= link_to root_path, class: "" do %>
    <%= image_tag 'logo.svg', alt: 'logo', class: ""%>
  <%end%>

  <div class="flex justify-between items-center">
    <nav class="navigation text-black">
      <ul class="font-medium flex">
        <li>
          <a href="#home" class="nav-link block py-2 pl-3 pr-4 text-white white:text-dark" aria-current="page">Home</a>
        </li>
        <li>
          <a href="#about" class="nav-link block py-2 pl-3 pr-4 text-white white:text-dark">About Us</a>
        </li>
        <li>
          <a href="#services" class="nav-link block py-2 pl-3 pr-4 text-white white:text-dark">Our Services</a>
        </li>
        <li>
          <a href="#contact" class="nav-link block py-2 pl-3 pr-4 text-white white:text-dark">Contact Us</a>
        </li>
        <li class="effect"></li>
      </ul>
    </nav>
    <% if current_user %>
      <button class="rounded border-2 border-gray-100 bg-transparent backdrop-blur bg-white bg-opacity-10 p-3 mx-8">
        <%= link_to "Sign out", destroy_user_session_path, :method => :delete %>
      </button>
    <% else %>
      <button class="rounded border-2 border-gray-100 bg-transparent backdrop-blur bg-white bg-opacity-10 p-3 mx-8">
        <%= link_to "Login", new_user_session_path, class:""%>
      </button>
      <%#<%#<%= link_to "Sign up!", new_user_registration_path, class:"underline font-bold m-4" %>
    <% end %>
  </div>
</header>

