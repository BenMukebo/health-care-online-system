<% provide(:title, "Dashboard") %>

<div class="flex w-full md:pt-8 relative md:ml-64 bg-blueGray-50 md:mw-[100% - 16rem]">
  <div class="w-3/12 flex justify-items-end">
  <div class="flex flex-col">
    <%= link_to admin_root_path, class: "pb-4 mb-1 rounded font-semibold items-center hover:bg-yellow-500 py-4 p-6" do%>
      <span class="">Dashboard</span>
    <%end%>
    <%= link_to dashboard_organizations_path, class: "pb-4 mb-1 rounded font-semibold hover:bg-yellow-500 py-4 p-6" do%>
      <span>My Organization</span>
    <%end%>
    <%= link_to home_path, class: "pb-4 mb-1 font-semibold rounded hover:bg-yellow-500 py-4 p-6" do%>
      <span>Home page</span>
    <%end%>
  </div>
</div>
</div>