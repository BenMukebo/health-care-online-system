<nav class="absolute top-0 left-0 w-full z-10 bg-transparent md:flex-row md:flex-nowrap md:justify-between flex items-center p-4">
    <div class="w-full mx-autp items-center flex justify-between md:flex-nowrap flex-wrap md:px-10 px-4">
      <div class="relative w-full hidden lg:inline-block px-4 max-w-full flex-grow flex-1">
        <div class="text-white font-semibold">
          <h2 class="text-lg uppercase">Hi, <%= current_user.first_name %></h2>
          <p class="text-gray-950 text-sm mt-2"> #<%= current_user.role.name %> </p>
        </div>
      </div>
        <%= render "dashboard/shared/search" %>

        <%# Click profile image popup%>
        <ul class="flex-col md:flex-row list-none items-center hidden md:flex">
          <%= turbo_frame_tag "user_dropdown" do %>
            <a class="text-blueGray-500 block" href="#" onclick="openDropdown(event,'user-dropdown')">
              <div class="items-center flex">
                <span
                  class="w-12 h-12 text-sm text-white bg-blueGray-200 inline-flex items-center justify-center rounded-full"
                  >
                  <%= image_tag current_user&.image, alt: 'user', class: "w-full rounded-full align-middle border-none shadow-lg"%>
                </span>
              </div>
            </a>
          <% end %>
            <div
              class="hidden bg-white text-base z-50 float-left py-2 list-none text-left rounded shadow-lg mt-1"
              style="min-width: 12rem;"
              id="user-dropdown"
            >
            <%= link_to "Profile", user_path(current_user), class: "text-sm py-2 px-4 font-normal block w-full whitespace-nowrap bg-transparent text-blueGray-700" %>
              <a
                href="#"
                class="text-sm py-2 px-4 font-normal block w-full whitespace-nowrap bg-transparent text-blueGray-700"
                >Action</a
              ><a
                href="#"
                class="text-sm py-2 px-4 font-normal block w-full whitespace-nowrap bg-transparent text-blueGray-700"
                >Another action</a
              >
              <div class="h-0 my-2 border border-solid border-blueGray-100"></div>
              <a
                href="#"
                class="text-sm py-2 px-4 font-normal block w-full whitespace-nowrap bg-transparent text-blueGray-700"
                >Settings</a
              >
              <%= link_to "Sign out", destroy_user_session_path, :method => :delete, class: "text-sm py-2 px-4 font-normal block w-full whitespace-nowrap bg-transparent text-pink-500" %>
            </div>
        </ul>
    </div>
 </nav>