<% provide(:title, "Home") %>

<div
class="relative pt-16 pb-32 flex content-center items-center justify-center bg-gray-900"
style="min-height: 75vh;"
>
<div
  class="absolute top-16 w-full h-full bg-center bg-cover bg-blueGray-50"
  style='background-image: url("");'
>

<div class="relative md:ml-64 bg-blueGray-50 md:mw-[100% - 16rem] w-full h-full  bg-slate-100">
  <h1 class="text-5xl">Welcome to the home page</h1>
  <br />
  
  <%#<% if user_signed_in? %>
  <% if current_user %>
    <p class="py-4 text-lg" > Hello you're logged in as: <%= current_user.email %>!</p>
    <p class="py-4 text-md"> Your role is: 
      <span class="text-sky-500"><%= current_user.role.name %>! </span>
      <% if current_user.role.name == 'super_admin' %>
        <%= link_to "Go the the bashbord", admin_root_path, class:"underline font-bold mx-2" %>
      <% end %>
      </p>
    <p>
      You have successfully authenticated your account.
      You are now ready to interact with this application.
    </p>
    <div class="flex py-4 gap-3">
      <%= link_to "Edit profile", edit_user_registration_path, class:"underline font-semibold p-2" %>
      <span class="text-orange-500 font-semibold p-2">
        <%= link_to "Sign out", destroy_user_session_path, :method => :delete %>
      </span>
      <%#<%= link_to "Sign out", destroy_user_session_path, 'data-turbo-method': :delete %>
      <%#<%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: "delete" } %>
    </div>
  <% else %>
    <p>You are not logged in.</p>
    <div class="flex py-4">
      <%= link_to "Sign up!", new_user_registration_path, class:"underline font-bold m-4" %>
      <%= link_to "Login", new_user_session_path, class:"underline font-bold m-4"%>
    </div>
  <% end %>
</div>
</div>
</div>