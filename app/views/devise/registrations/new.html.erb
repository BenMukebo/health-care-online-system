<% provide(:title, "sign-up") %>

<div
  class="absolute top-0 w-full h-full bg-gray-900"
  style="background-image: url(./assets/img/register_bg_2.png); background-size: 100%; background-repeat: no-repeat;"
></div>

<div class="container mx-auto px-4 h-full">
  <div class="flex content-center items-center justify-center h-full">
    <div class="w-full lg:w-8/12 xl:w-6/12 2xl:max-w-2xl px-4">
      <div
        class="relative flex flex-col min-w-0 break-words w-full mb-6 shadow-lg rounded-lg bg-gray-300 border-0"
      >      
        <div class="flex-auto px-6 lg:px-10 py-10">
          <h6 class="text-gray-600 text-sm font-bold text-center mb-3">Sign in with</h6>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="relative w-full mb-3">
              <%= f.label :first_name, class: "block uppercase text-gray-700 text-xs font-bold mb-2" %>
              <%= f.text_field :first_name, autocomplete: "first_name",  placeholder: "First name", class: "border-0 px-3 py-3 placeholder-gray-400 text-gray-700 bg-white rounded text-sm shadow focus:outline-none focus:ring w-full", style: "transition: all 0.15s ease 0s;" %>
            </div>

            <div class="relative w-full mb-3">
              <%= f.label :familly_name, class: "block uppercase text-gray-700 text-xs font-bold mb-2" %>
              <%= f.text_field :familly_name, autocomplete: "family_name",  placeholder: "Last name", class: "border-0 px-3 py-3 placeholder-gray-400 text-gray-700 bg-white rounded text-sm shadow focus:outline-none focus:ring w-full", style: "transition: all 0.15s ease 0s;" %>
            </div>

            <div class="relative w-full mb-3">
              <%= f.label :email, class: "block uppercase text-gray-700 text-xs font-bold mb-2" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email", class: "border-0 px-3 py-3 placeholder-gray-400 text-gray-700 bg-white rounded text-sm shadow focus:outline-none focus:ring w-full", style: "transition: all 0.15s ease 0s;" %>
            </div>

            <div class="relative w-full mb-3">
              <%= f.label :password, class: "block uppercase text-gray-700 text-xs font-bold mb-2" %>
              <%= f.password_field :password, autocomplete: "new-password",  placeholder: "Password", class: "border-0 px-3 py-3 placeholder-gray-400 text-gray-700 bg-white rounded text-sm shadow focus:outline-none focus:ring w-full", style: "transition: all 0.15s ease 0s;" %>
            </div>


            <div class="relative w-full mb-6">
            <%#<%= f.label :password_confirmation, class: "block uppercase text-gray-700 text-xs font-bold mb-2" %>
            <%#<%= f.password_field :password_confirmation, autocomplete: "new-password",  placeholder: "Password", class: "border-0 px-3 py-3 placeholder-gray-400 text-gray-700 bg-white rounded text-sm shadow focus:outline-none focus:ring w-full", style: "transition: all 0.15s ease 0s;" %>
            </div>

            <div  class="inline-flex items-center cursor-pointer">
              <%= f.check_box :agreed_to_terms, class: "form-checkbox border-0 rounded text-gray-800 ml-1 w-5 h-5", style: "transition: all 0.15s ease 0s;" %>
              <%= f.label :agreed_to_terms, "Terms & Conditions", class: "ml-2 text-sm font-semibold text-gray-700" %>
            </div>

            <div class="text-center mt-6">
              <%= f.submit "Sign up", data: {turbo: false}, class:"bg-gray-900 text-white active:bg-gray-700 text-sm font-bold uppercase px-6 py-3 rounded shadow hover:shadow-lg outline-none focus:outline-none mr-1 mb-1 w-full", style: "transition: all 0.15s ease 0s;" %>
            </div>
          <% end %>

          <%= render "devise/shared/links" %>
        </div>
      </div>

      <div class="flex flex-wrap mt-6">
        <div class="w-1/2">
          <a href="#pablo" class="text-gray-300"
            ><small>Forgot password?</small></a
          >
        </div>
        <div class="w-1/2 text-right">
          <a href="#pablo" class="text-gray-300"
            ><small>Create new account</small></a
          >
        </div>
      </div>
    </div>
  </div>
</div>
