<div id="clearance text-center" class="sign-in w-full md:w-1/2 mx-auto">
  <h2 class="text-xl font-bold mb-4">Login Page</h2>
  <hr/>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="text-field field flex flex-col w-11/12 md:w-1/2 mt-4 mb-9">
    <%= f.label :email, class: "font-semibold pb-4 " %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="password-field field flex flex-col w-11/12 md:w-1/2 mt-4 mb-9">
    <%= f.label :password, class: "font-semibold pb-4" %>
    <%= f.password_field :password, autocomplete: "current-password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="field my-4">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me %>
    </div>
  <% end %>

  <div class="submit-field flex flex-col w-11/12 md:w-1/2 my-2">
    <%= f.submit "Log in", data: {turbo: false}, class:"bg-sky-500 cursor-pointer text-white rounded p-2 font-bold" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>

</div>
