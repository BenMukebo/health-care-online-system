<!DOCTYPE html>
<html>
  <head>
    <title>HealthCareOnlineSystem</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://kit.fontawesome.com/29d7bf5b00.js" crossorigin="anonymous"></script>
    <script src="https://kit.fontawesome.com/9ef5f4f831.js" crossorigin="anonymous"></script>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
    <%# <%= stylesheet_link_tag 'wind', media: 'all', 'data-turbolinks-track': 'reload' %>
    <script src="https://cdn.tailwindcss.com"></script>

  </head>

  <body>
    <p class="notice" style="display: block;"><%= notice %></p>
    <p class="alert" style="display: block;"><%= alert %></p>
    <main class="container w-full max-w-full bg-red mx-auto md:pt-8">
      <%= yield %>
    </main>
  </body>
</html>
